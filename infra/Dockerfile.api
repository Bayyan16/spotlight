FROM node:20-alpine AS console
WORKDIR /console
COPY console/package.json console/package-lock.json* ./
RUN npm ci --silent || npm install --silent
COPY console/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc git && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY spotlight ./spotlight
COPY targets ./targets
COPY data ./data
COPY docs ./docs
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
COPY --from=console /console/dist ./console/dist

# Optional: injected by CI so /docs/architecture shows the build commit.
# When absent, the doc page shows "dev".
ARG GIT_SHA
ENV GIT_SHA=${GIT_SHA:-dev}

RUN pip install --no-cache-dir -e .

EXPOSE 8000

# Deploy hook: apply pending Alembic migrations, then start the API.
# `alembic upgrade head` is idempotent — re-running with no pending
# migrations is a no-op — so it is safe to run on every container start.
# When we split the API and worker into separate services (P1.2), the
# worker service uses the same entrypoint pattern.
CMD ["sh", "-c", "alembic upgrade head && python -u -m uvicorn spotlight.api.app:app --host 0.0.0.0 --port 8000"]
